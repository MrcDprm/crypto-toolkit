@{
    ViewData["Title"] = T["tool.sign.name"];
    ViewData["SeoKey"] = "sign";
}
@section Head {
    <script type="module" src="~/js/ui/sign.js" asp-append-version="true"></script>
}

<header class="tool-head">
    <p class="eyebrow">ECDSA · P-256 · SHA-256</p>
    <h1>@T["tool.sign.name"]</h1>
    <p class="tool-head__lead">@T["sign.lead"]</p>
</header>

<form class="pane keygen" id="keygen-form" novalidate>
    <h2 class="pane__title"><span class="step">1</span> @T["sign.keys.title"]</h2>
    <div class="keygen__row">
        <button type="submit" class="btn" id="generate">@T["rsa.keys.generate"]</button>
    </div>
    <p class="status" id="keygen-status" role="status" hidden></p>

    <div id="keys" hidden>
        <p class="fingerprint">@T["info.fingerprint"]: <code id="key-fingerprint"></code></p>
        <div class="keys__grid">
            <div class="field">
                <label for="public-pem">@T["sign.keys.public"]</label>
                <textarea id="public-pem" class="mono-area pem-area" wrap="off" rows="5" readonly spellcheck="false"></textarea>
                <div class="actions">
                    <button type="button" class="btn btn--ghost" data-copy="#public-pem">@T["form.copy"]</button>
                    <a class="btn btn--ghost" id="download-public" href="#" download>signing-public.pem</a>
                </div>
            </div>
            <div class="field">
                <label for="private-pem">@T["sign.keys.private"]</label>
                <textarea id="private-pem" class="mono-area pem-area" wrap="off" rows="5" readonly spellcheck="false"></textarea>
                <div class="actions">
                    <button type="button" class="btn btn--ghost" data-copy="#private-pem">@T["form.copy"]</button>
                    <a class="btn btn--ghost" id="download-private" href="#" download>signing-private.pem</a>
                </div>
            </div>
        </div>
        <p class="note">@T["rsa.keys.warning"]</p>
    </div>
</form>

<form class="bench" id="sign-form" novalidate autocomplete="off" data-mode="sign" data-source="text">
    <h2 class="bench__title"><span class="step">2</span> @T["sign.bench.title"]</h2>
    <div class="bench__controls">
        <fieldset class="segmented">
            <legend class="sr-only">@T["form.mode"]</legend>
            <label><input type="radio" name="mode" value="sign" checked /><span>@T["sign.mode.sign"]</span></label>
            <label><input type="radio" name="mode" value="verify" /><span>@T["sign.mode.verify"]</span></label>
        </fieldset>
        <fieldset class="segmented">
            <legend class="sr-only">@T["form.source"]</legend>
            <label><input type="radio" name="source" value="text" checked /><span>@T["form.text"]</span></label>
            <label><input type="radio" name="source" value="file" /><span>@T["form.file"]</span></label>
        </fieldset>
    </div>

    <div class="bench__grid">
        <section class="pane" aria-labelledby="input-title">
            <h3 class="pane__title" id="input-title">@T["form.input"]</h3>

            <div class="field" data-show-mode="sign">
                <label for="private-input">@T["sign.privateLabel"]</label>
                <textarea id="private-input" class="mono-area pem-area" wrap="off" rows="4" spellcheck="false" placeholder="-----BEGIN PRIVATE KEY-----"></textarea>
            </div>
            <div class="field" data-show-mode="verify">
                <label for="public-input">@T["sign.publicLabel"]</label>
                <textarea id="public-input" class="mono-area pem-area" wrap="off" rows="4" spellcheck="false" placeholder="-----BEGIN PUBLIC KEY-----"></textarea>
            </div>

            <div class="field" data-show-source="text">
                <label for="text-input">@T["sign.textLabel"]</label>
                <textarea id="text-input" class="mono-area" rows="5" spellcheck="false" maxlength="2000000"></textarea>
            </div>

            <div class="field" data-show-source="file">
                <span class="field__label">@T["form.file"]</span>
                <label class="dropzone" id="dropzone">
                    <input type="file" class="sr-only" />
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V4M7 9l5-5 5 5M5 15v4a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-4" /></svg>
                    <span class="dropzone__text">@T["file.choose"]</span>
                    <span class="dropzone__name" data-file-name></span>
                    <span class="dropzone__hint">@T["file.limit"]</span>
                </label>
            </div>

            <div class="field" data-show-mode="verify">
                <label for="signature-input">@T["sign.signatureLabel"]</label>
                <textarea id="signature-input" class="mono-area" rows="3" spellcheck="false"></textarea>
                <label class="btn btn--ghost btn--small file-btn">
                    <input type="file" id="signature-file" class="sr-only" accept=".sig,.txt" />
                    @T["sign.loadSig"]
                </label>
            </div>

            <button type="submit" class="btn btn--block" id="run"></button>
            <p class="status" id="status" role="status" hidden></p>
        </section>

        <section class="pane pane--output" aria-labelledby="output-title">
            <h3 class="pane__title" id="output-title">@T["form.output"]</h3>

            <div class="output-empty" id="output-empty">@T["form.outputEmpty"]</div>

            <div id="output" hidden>
                <div class="field" data-show-mode="sign">
                    <label for="signature-output">@T["sign.signatureLabel"]</label>
                    <textarea id="signature-output" class="mono-area" rows="3" readonly spellcheck="false"></textarea>
                    <div class="actions">
                        <button type="button" class="btn btn--ghost" data-copy="#signature-output">@T["form.copy"]</button>
                        <a class="btn btn--ghost" id="download-sig" href="#" download></a>
                        <button type="button" class="btn btn--ghost" id="try-verify">@T["sign.tryVerify"]</button>
                    </div>
                </div>

                <div class="verdict" id="verdict" data-show-mode="verify" data-valid="false">
                    <svg class="verdict__icon verdict__icon--ok" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
                    <svg class="verdict__icon verdict__icon--bad" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
                    <div>
                        <p class="verdict__title" id="verdict-title"></p>
                        <p class="verdict__text" id="verdict-text"></p>
                    </div>
                </div>

                <dl class="package-info">
                    <div><dt>@T["info.algorithm"]</dt><dd>ECDSA P-256 · SHA-256</dd></div>
                    <div data-show-mode="verify"><dt>@T["info.fingerprint"]</dt><dd id="info-fingerprint"></dd></div>
                    <div><dt>@T["info.digest"]</dt><dd id="info-digest"></dd></div>
                    <div><dt>@T["info.size"]</dt><dd id="info-size"></dd></div>
                </dl>
            </div>
        </section>
    </div>
</form>

<details class="how">
    <summary>@T["how.title"]</summary>
    <div class="how__body">
        <ol class="how__steps">
            <li>@T["sign.how.1"]</li>
            <li>@T["sign.how.2"]</li>
            <li>@T["sign.how.3"]</li>
            <li>@T["sign.how.4"]</li>
        </ol>
        <p class="note">@T["sign.how.warning"]</p>
    </div>
</details>

<partial name="_ScriptText" />
