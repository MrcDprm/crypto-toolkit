@{
    ViewData["Title"] = T["tool.encrypt.name"];
}
@section Head {
    <script type="module" src="~/js/ui/encrypt.js" asp-append-version="true"></script>
}

<header class="tool-head">
    <p class="eyebrow">AES-256-GCM · PBKDF2-SHA256</p>
    <h1>@T["tool.encrypt.name"]</h1>
    <p class="tool-head__lead">@T["encrypt.lead"]</p>
</header>

<form class="bench" id="encrypt-form" novalidate autocomplete="off" data-mode="encrypt" data-source="text">
    <div class="bench__controls">
        <fieldset class="segmented">
            <legend class="sr-only">@T["form.mode"]</legend>
            <label><input type="radio" name="mode" value="encrypt" checked /><span>@T["form.encrypt"]</span></label>
            <label><input type="radio" name="mode" value="decrypt" /><span>@T["form.decrypt"]</span></label>
        </fieldset>
        <fieldset class="segmented">
            <legend class="sr-only">@T["form.source"]</legend>
            <label><input type="radio" name="source" value="text" checked /><span>@T["form.text"]</span></label>
            <label><input type="radio" name="source" value="file" /><span>@T["form.file"]</span></label>
        </fieldset>
    </div>

    <div class="bench__grid">
        <section class="pane" aria-labelledby="input-title">
            <h2 class="pane__title" id="input-title">@T["form.input"]</h2>

            <div class="field" data-show-source="text">
                <label for="text-input">
                    <span data-show-mode="encrypt">@T["encrypt.textLabel"]</span>
                    <span data-show-mode="decrypt">@T["encrypt.packageLabel"]</span>
                </label>
                <textarea id="text-input" class="mono-area" rows="7" spellcheck="false" maxlength="2000000"></textarea>
            </div>

            <div class="field" data-show-source="file">
                <span class="field__label">@T["form.file"]</span>
                <label class="dropzone" id="dropzone">
                    <input type="file" class="sr-only" />
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V4M7 9l5-5 5 5M5 15v4a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-4" /></svg>
                    <span class="dropzone__text">@T["file.choose"]</span>
                    <span class="dropzone__name" data-file-name></span>
                    <span class="dropzone__hint">@T["file.limit"]</span>
                </label>
            </div>

            <div class="field">
                <label for="password">@T["form.password"]</label>
                <div class="input-row">
                    <input id="password" type="password" autocomplete="new-password" spellcheck="false" />
                    <button type="button" class="icon-btn" data-reveal="#password" aria-pressed="false" aria-label="@T["form.show"]">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /></svg>
                    </button>
                </div>
                <div class="strength" data-show-mode="encrypt" data-level="0">
                    <span class="strength__bar" aria-hidden="true"><span></span><span></span><span></span></span>
                    <span class="strength__text" id="strength-text" aria-live="polite"></span>
                </div>
            </div>

            <div class="field" data-show-mode="encrypt">
                <label for="confirm">@T["form.confirm"]</label>
                <input id="confirm" type="password" autocomplete="new-password" spellcheck="false" />
            </div>

            <button type="submit" class="btn btn--block" id="run"></button>
            <p class="status" id="status" role="status" hidden></p>
        </section>

        <section class="pane pane--output" aria-labelledby="output-title">
            <h2 class="pane__title" id="output-title">@T["form.output"]</h2>

            <div class="output-empty" id="output-empty">@T["form.outputEmpty"]</div>

            <div id="output" hidden>
                <div class="field" data-show-source="text">
                    <label for="text-output">
                        <span data-show-mode="encrypt">@T["encrypt.packageLabel"]</span>
                        <span data-show-mode="decrypt">@T["encrypt.plainLabel"]</span>
                    </label>
                    <textarea id="text-output" class="mono-area" rows="7" readonly spellcheck="false"></textarea>
                    <div class="actions">
                        <button type="button" class="btn btn--ghost" data-copy="#text-output">@T["form.copy"]</button>
                        <button type="button" class="btn btn--ghost" id="try-decrypt" data-show-mode="encrypt">@T["encrypt.tryDecrypt"]</button>
                    </div>
                </div>

                <div class="field" data-show-source="file">
                    <a class="btn" id="download" href="#" download>@T["form.download"]</a>
                    <p class="muted small" id="download-name"></p>
                </div>

                <dl class="package-info" id="package-info">
                    <div><dt>@T["info.format"]</dt><dd id="info-format"></dd></div>
                    <div><dt>@T["info.iterations"]</dt><dd id="info-iterations"></dd></div>
                    <div><dt>Salt</dt><dd id="info-salt"></dd></div>
                    <div><dt>IV</dt><dd id="info-iv"></dd></div>
                    <div><dt>@T["info.size"]</dt><dd id="info-size"></dd></div>
                </dl>
            </div>
        </section>
    </div>
</form>

<details class="how">
    <summary>@T["how.title"]</summary>
    <div class="how__body">
        <ol class="how__steps">
            <li>@T["encrypt.how.1"]</li>
            <li>@T["encrypt.how.2"]</li>
            <li>@T["encrypt.how.3"]</li>
            <li>@T["encrypt.how.4"]</li>
        </ol>

        <figure class="layout-diagram">
            <figcaption>@T["encrypt.how.layout"]</figcaption>
            <div class="layout-diagram__bar">
                <span class="seg seg--meta">CTK<small>3 B</small></span>
                <span class="seg seg--meta">v1<small>1 B</small></span>
                <span class="seg seg--meta">@T["info.iterations"]<small>4 B</small></span>
                <span class="seg seg--salt">Salt<small>16 B</small></span>
                <span class="seg seg--iv">IV<small>12 B</small></span>
                <span class="seg seg--data">@T["encrypt.how.ciphertext"]<small>n B</small></span>
                <span class="seg seg--tag">GCM tag<small>16 B</small></span>
            </div>
        </figure>

        <p class="note">@T["encrypt.how.warning"]</p>
    </div>
</details>

<partial name="_ScriptText" />
