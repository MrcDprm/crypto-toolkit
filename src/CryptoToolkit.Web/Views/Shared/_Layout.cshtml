@{
    var english = Culture.IsEnglish;
    // The language link returns to the same page without ?lang, so the cookie decides.
    var path = Seo.WithoutLang(Context.Request.Path, Context.Request.Query);
    var title = ViewData["Title"]?.ToString();
    // Pages listed in Seo.Pages set SeoKey; anything else (errors) stays out of search.
    var seoKey = ViewData["SeoKey"] as string;
    var fullTitle = seoKey != null
        ? T[$"seo.{seoKey}.title"].Value
        : string.IsNullOrEmpty(title) ? "Crypto Toolkit" : title + " · Crypto Toolkit";
    var description = seoKey is null or "home"
        ? T["meta.description"].Value
        : $"{T[$"tool.{seoKey}.summary"]} {T["seo.local"]}";
    var pagePath = Context.Request.Path.Value is { Length: > 1 } p ? p.TrimEnd('/') : "/";
    var urlTr = Seo.PageUrl(pagePath, english: false);
    var urlEn = Seo.PageUrl(pagePath, english: true);
    var jsonLd = seoKey == null ? null : Seo.JsonLd(new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "WebApplication",
        ["name"] = seoKey == "home" ? "Crypto Toolkit" : $"{title} · Crypto Toolkit",
        ["url"] = english ? urlEn : urlTr,
        ["description"] = description,
        ["inLanguage"] = english ? "en" : "tr",
        ["applicationCategory"] = "SecurityApplication",
        ["operatingSystem"] = "Web",
        ["isAccessibleForFree"] = true,
        ["offers"] = new Dictionary<string, object> { ["@type"] = "Offer", ["price"] = "0", ["priceCurrency"] = "USD" },
        ["author"] = new Dictionary<string, object> { ["@type"] = "Person", ["name"] = "Miraç Deprem", ["url"] = "https://www.miracdeprem.com" },
    });
    var current = Context.Request.Path.Value;
}
<!DOCTYPE html>
<html lang="@(english ? "en" : "tr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@fullTitle</title>
    <meta name="description" content="@description" />
    @if (seoKey == null)
    {
        <meta name="robots" content="noindex" />
    }
    else
    {
        <link rel="canonical" href="@(english ? urlEn : urlTr)" />
        <link rel="alternate" hreflang="tr" href="@urlTr" />
        <link rel="alternate" hreflang="en" href="@urlEn" />
        <link rel="alternate" hreflang="x-default" href="@urlTr" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Crypto Toolkit" />
        <meta property="og:title" content="@fullTitle" />
        <meta property="og:description" content="@description" />
        <meta property="og:url" content="@(english ? urlEn : urlTr)" />
        <meta property="og:image" content="@Seo.Image" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:locale" content="@(english ? "en_US" : "tr_TR")" />
        <meta property="og:locale:alternate" content="@(english ? "tr_TR" : "en_US")" />
        <meta name="twitter:card" content="summary_large_image" />
        @* "!" keeps the script tag helper from encoding the + in the type *@
        <!script type="application/ld+json">@Html.Raw(jsonLd)</!script>
    }
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
    <link rel="preload" href="~/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="skip-link" href="#main">@T["nav.skip"]</a>

    <header class="site-header">
        <div class="container site-header__inner">
            <a class="brand" href="/" aria-label="Crypto Toolkit">
                <svg class="brand__mark" viewBox="0 0 64 64" aria-hidden="true">
                    <rect width="64" height="64" rx="14" fill="#0a0f0d" />
                    <path d="M22 30v-8a10 10 0 0 1 20 0v8" fill="none" stroke="#3ee6b0" stroke-width="5" stroke-linecap="round" />
                    <rect x="15" y="29" width="34" height="24" rx="5" fill="#3ee6b0" />
                    <circle cx="32" cy="39" r="3.5" fill="#0a0f0d" />
                    <rect x="30.5" y="40" width="3" height="7" rx="1.5" fill="#0a0f0d" />
                </svg>
                <span class="brand__name">crypto<span class="brand__slash">/</span>toolkit</span>
            </a>

            <nav class="main-nav" aria-label="@T["nav.main"]">
                @foreach (var tool in Tools.All)
                {
                    <a href="@tool.Url" aria-current="@(current == tool.Url ? "page" : null)">@T[$"tool.{tool.Key}.name"]</a>
                }
            </nav>

            <div class="toolbar">
                <a class="icon-btn lang" href="/lang/@(english ? "tr" : "en")?returnUrl=@Uri.EscapeDataString(path)"
                   lang="@(english ? "tr" : "en")" aria-label="@T["nav.language"]">@(english ? "TR" : "EN")</a>
                <button class="icon-btn" type="button" data-theme-toggle aria-label="@T["nav.theme"]">
                    <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
                    <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                </button>
            </div>
        </div>
    </header>

    <main id="main" class="container main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container site-footer__inner">
            <p class="badge"><span class="badge__dot" aria-hidden="true"></span>@T["badge.local"]</p>
            <p class="muted small">@T["footer.note"]</p>
            @* Every live project links to the others; the current one is highlighted. *@
            <nav class="footer-projects" aria-label="@T["footer.projects"]">
                <a href="https://crypto.miracdeprem.com" aria-current="page">Crypto Toolkit</a>
                <a href="https://sahaf.miracdeprem.com">Sahaf</a>
                <a href="https://tictactoe.miracdeprem.com">Tic-Tac-Toe</a>
                <a href="https://hangman.miracdeprem.com">Hangman</a>
                <a href="https://quiz.miracdeprem.com">Quiz App</a>
                <a href="https://weather.miracdeprem.com">Weather App</a>
                <a href="https://kvkk.miracdeprem.com">KVKK Assistant</a>
                <a href="https://seans.miracdeprem.com">Seans</a>
                <a href="https://spygame.miracdeprem.com">Casus</a>
                <a href="https://zarf.miracdeprem.com">Zarf</a>
                <a href="https://brain.miracdeprem.com">Brain Weight</a>
            </nav>
            <div class="footer-meta">
                <span>© 2026 Miraç Deprem</span>
                <a href="https://www.miracdeprem.com">@T["footer.portfolio"]</a>
                <a href="https://github.com/MrcDprm/crypto-toolkit">@T["footer.source"]</a>
            </div>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
